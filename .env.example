# ==============================
# Segurança / Autenticação
# ==============================
# Token (API Key) exigido pelo servidor MCP para autenticar o cliente/agente.
# Gere um valor forte e aleatório (ex.: 32+ caracteres).
APP_API_KEY=change-this-to-a-strong-random-token

# ==============================
# Cache Redis
# ==============================
# Host do Redis (no docker-compose, o serviço se chama "redis").
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Defina senha em produção; pode ficar vazio em ambiente local.
REDIS_PASSWORD=

# ==============================
# Observabilidade / Prometheus
# ==============================
METRICS_HOST=0.0.0.0
METRICS_PORT=9100

# ==============================
# Performance / Rate limiting
# ==============================
# TTL do cache em segundos para reduzir chamadas repetidas ao Yahoo.
CACHE_TTL_SECONDS=300
