# =============================================
# Segurança
# =============================================
# Token obrigatório para autenticação do cliente no servidor MCP.
APP_API_KEY=change-this-to-a-strong-random-token

# =============================================
# Redis (cache)
# =============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================
# Métricas (Prometheus)
# =============================================
METRICS_HOST=0.0.0.0
METRICS_PORT=9100

# =============================================
# Cache TTL
# =============================================
CACHE_TTL_SECONDS=300

# =============================================
# Transporte MCP
# =============================================
# stdio -> integração local com agente anexado ao processo
# streamable-http -> execução em servidor/container
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
